# Copy this file to .env and fill in real values. Never commit .env to GitHub.

# MySQL connection. URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=mysql+pymysql://tracktech_app:CHANGE_ME@127.0.0.1:3306/tracktech_db

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long a login lasts (minutes)
ACCESS_TOKEN_MINUTES=120

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GPS simulator. Keep uvicorn at ONE worker while this is enabled,
# otherwise every worker runs its own simulator and positions are duplicated.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=3
# Simulated time runs this many times faster than real time, so demo trips finish in minutes
SIMULATOR_SPEED_MULTIPLIER=20

# Login protection: lock an email after N failed attempts for M minutes
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# Passwords for the seeded accounts. If left empty, the seed script generates
# random passwords and prints them once.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_VIEWER_PASSWORD=
